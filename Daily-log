<script>
// ══════════════════════════════════════════════════
//  STATE
// ══════════════════════════════════════════════════
const DEFAULT_PW = 'bcps2025';
let state = loadState();

function defaultState() {
  return {
    pw: DEFAULT_PW,
    jobs: [
      { id: uid(), name: 'High Winds Hotel – Casino', num: '2025-001', client: 'High Winds LLC', status: 'active', codes: ['HW-GC','HW-ELECTRICAL','HW-FRAMING'] },
      { id: uid(), name: 'High Winds Hotel – Warehouse', num: '2025-002', client: 'High Winds LLC', status: 'active', codes: ['HW-WH-GC','HW-WH-SITE'] },
      { id: uid(), name: 'Oelke Site Work', num: '2025-003', client: 'Oelke Construction', status: 'active', codes: ['OEL-SITE','OEL-UTIL'] },
    ],
    tasks: [],
    driveClientId: '',
    driveConnected: false,
    driveToken: '',
    driveTokenExp: 0,
    driveRootFolderId: ''
  };
}

function loadState() {
  try {
    const s = localStorage.getItem('bcps_state');
    if (s) return JSON.parse(s);
  } catch(e) {}
  return defaultState();
}

function saveState() {
  localStorage.setItem('bcps_state', JSON.stringify(state));
}

function uid() {
  return Math.random().toString(36).substr(2,9);
}

// ══════════════════════════════════════════════════
//  INIT
// ══════════════════════════════════════════════════
document.addEventListener('DOMContentLoaded', () => {
  const d = new Date().toISOString().slice(0,10);
  document.getElementById('d_date').value = d;
  document.getElementById('p_date').value = d;
  document.getElementById('ss_date').value = d;
  document.getElementById('sp_date').value = d;

  refreshJobDropdowns();
  addMpRow();
  addPunch(); addPunch(); addPunch();
  initSig('sigS'); initSig('sigP');
  renderTasks();
  checkDriveCallback();
  updateDriveUI();
});

// ══════════════════════════════════════════════════
//  TABS
// ══════════════════════════════════════════════════
function switchTab(tab, btn) {
  document.querySelectorAll('.tab-page').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
