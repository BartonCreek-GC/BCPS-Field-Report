// ══════════════════════════════════════════════════
//  SIGNATURES
// ══════════════════════════════════════════════════
function initSig(id) {
  const cv = document.getElementById(id);
  const ctx = cv.getContext('2d');
  let inking = false, lx=0, ly=0;

  function pos(e) {
    const r = cv.getBoundingClientRect();
    const sx = cv.width/r.width, sy = cv.height/r.height;
    if (e.touches) return [(e.touches[0].clientX-r.left)*sx,(e.touches[0].clientY-r.top)*sy];
    return [(e.clientX-r.left)*sx,(e.clientY-r.top)*sy];
  }
  function start(e){e.preventDefault();inking=true;cv.classList.add('inking');[lx,ly]=pos(e);}
  function draw(e){
    if(!inking)return;e.preventDefault();
    const [x,y]=pos(e);
    ctx.beginPath();ctx.moveTo(lx,ly);ctx.lineTo(x,y);
    ctx.strokeStyle='#e8a020';ctx.lineWidth=2.5;ctx.lineCap='round';ctx.lineJoin='round';ctx.stroke();
    [lx,ly]=[x,y];
  }
  function stop(){inking=false;cv.classList.remove('inking');}
  cv.addEventListener('mousedown',start);cv.addEventListener('mousemove',draw);
  cv.addEventListener('mouseup',stop);cv.addEventListener('mouseleave',stop);
  cv.addEventListener('touchstart',start,{passive:false});
  cv.addEventListener('touchmove',draw,{passive:false});
  cv.addEventListener('touchend',stop);
}
function clrSig(id){
  const cv=document.getElementById(id);
  cv.getContext('2d').clearRect(0,0,cv.width,cv.height);
}
function sigEmpty(id){
  const cv=document.getElementById(id);
  return !cv.getContext('2d').getImageData(0,0,cv.width,cv.height).data.some(v=>v!==0);
}

// ══════════════════════════════════════════════════
//  TASKS
// ══════════════════════════════════════════════════
function addTask() {
  const txt = document.getElementById('t_newText').value.trim();
  const jobId = document.getElementById('t_newJob').value;
  if (!txt) { document.getElementById('t_newText').focus(); return; }
  state.tasks.push({ id: uid(), text: txt, jobId, done: false, created: new Date().toISOString() });
  document.getElementById('t_newText').value = '';
  saveState();
  renderTasks();
}
function toggleTask(id) {
  const t = state.tasks.find(t => t.id === id);
  if (t) { t.done = !t.done; saveState(); renderTasks(); }
}
function removeTask(id) {
  state.tasks = state.tasks.filter(t => t.id !== id);
  saveState(); renderTasks();
}
function renderTasks() {
  const filter = document.getElementById('t_jobFilter')?.value || 'all';
  const list = document.getElementById('taskList');
  const tasks = state.tasks.filter(t => filter === 'all' || t.jobId === filter);
  const open = tasks.filter(t => !t.done).length;
  document.getElementById('taskBadge').textContent = open + ' open';

  if (!tasks.length) {
    list.innerHTML = `<div style="text-align:center;color:var(--slate);font-size:13px;padding:20px;">No tasks${filter!=='all'?' for this job':''}. Add one above.</div>`;
    return;
  }

  // open first, done after
  const sorted = [...tasks.filter(t=>!t.done), ...tasks.filter(t=>t.done)];
  list.innerHTML = sorted.map(t => {
    const job = state.jobs.find(j => j.id === t.jobId);
    const tag = job ? job.name.split('–')[0].trim() : '';
    return `<div class="task-item">
      <input type="checkbox" class="task-chk" ${t.done?'checked':''} onchange="toggleTask('${t.id}')">
      <span class="task-txt ${t.done?'done':''}">${esc(t.text)}</span>
      ${tag ? `<span class="task-tag">${esc(tag)}</span>` : ''}
      <button class="task-rm" onclick="removeTask('${t.id}')">✕</button>
    </div>`;
  }).join('');
}

function esc(s) {
  return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

// ══════════════════════════════════════════════════
//  ADMIN
// ══════════════════════════════════════════════════
let adminUnlocked = false;
let editingJobId = null;
let pendingCodes = [];

function openAdmin() {
  document.getElementById('adminOverlay').classList.add('open');
  if (!adminUnlocked) {
    document.getElementById('adminGate').style.display = '';
    document.getElementById('adminContent').style.display = 'none';
  }
}
function closeAdmin() {
  document.getElementById('adminOverlay').classList.remove('open');
}
function checkPW() {
  const pw = document.getElementById('adminPW').value;
  if (pw === state.pw) {
    adminUnlocked = true;
    document.getElementById('adminGate').style.display = 'none';
    document.getElementById('adminContent').style.display = '';
    renderJobsList();
    updateAdminDriveStatus();
  } else {
    document.getElementById('pwErr').textContent = 'Incorrect password.';
    document.getElementById('adminPW').value = '';
  }
}
function changePW() {
  const np = document.getElementById('newPW').value.trim();
  if (!np) return alert('Enter a new password.');
  state.pw = np; saveState();
  document.getElementById('newPW').value = '';
  alert('Password updated.');
}

function renderJobsList() {
  const el = document.getElementById('jobsList');
  el.innerHTML = state.jobs.map(j => `
    <div class="job-item">
      <div style="flex:1">
        <div class="job-item-name">${esc(j.name)} <span style="color:var(--slate);font-size:11px;">${j.num}</span></div>
        <div class="job-item-codes">${j.codes.join(' · ') || 'No billing codes'}</div>
      </div>
      <span class="job-item-status ${j.status==='active'?'status-active':'status-inactive'}">${j.status}</span>
      <button class="job-edit-btn" onclick="editJob('${j.id}')">Edit</button>
      <button class="job-edit-btn" style="color:var(--red);border-color:var(--red);" onclick="deleteJob('${j.id}')">Del</button>
    </div>`).join('');
}

function editJob(id) {
  const j = state.jobs.find(j => j.id === id);
  if (!j) return;
  editingJobId = id;
  pendingCodes = [...j.codes];
  document.getElementById('aj_name').value = j.name;
  document.getElementById('aj_num').value = j.num;
  document.getElementById('aj_client').value = j.client || '';
  document.getElementById('aj_status').value = j.status;
  renderBCChips();
  document.getElementById('addJobForm').scrollIntoView({behavior:'smooth'});
}

function deleteJob(id) {
  if (!confirm('Delete this job? Tasks assigned to it will become unassigned.')) return;
  state.jobs = state.jobs.filter(j => j.id !== id);
  saveState(); renderJobsList(); refreshJobDropdowns();
}

function addBillingCode() {
  const v = document.getElementById('bc_new').value.trim().toUpperCase();
  if (!v) return;
  if (!pendingCodes.includes(v)) pendingCodes.push(v);
  document.getElementById('bc_new').value = '';
  renderBCChips();
}

function removeBillingCode(code) {
  pendingCodes = pendingCodes.filter(c => c !== code);
  renderBCChips();
}

function renderBCChips() {
  document.getElementById('bcList').innerHTML = pendingCodes.map(c =>
    `<span class="bc-chip">${esc(c)}<button onclick="removeBillingCode('${esc(c)}')">×</button></span>`
  ).join('');
}

function saveJob() {
  const name = document.getElementById('aj_name').value.trim();
  if (!name) return alert('Job name required.');
  const job = {
    id: editingJobId || uid(),
    name,
    num: document.getElementById('aj_num').value.trim(),
    client: document.getElementById('aj_client').value.trim(),
    status: document.getElementById('aj_status').value,
    codes: [...pendingCodes]
  };
  if (editingJobId) {
    const idx = state.jobs.findIndex(j => j.id === editingJobId);
    if (idx > -1) state.jobs[idx] = job;
  } else {
    state.jobs.push(job);
  }
  saveState(); resetJobForm(); renderJobsList(); refreshJobDropdowns();
}

function resetJobForm() {
  editingJobId = null; pendingCodes = [];
  ['aj_name','aj_num','aj_client','bc_new'].forEach(id => document.getElementById(id).value = '');
  document.getElementById('aj_status').value = 'active';
  document.getElementById('bcList').innerHTML = '';
}

// ══════════════════════════════════════════════════
//  GOOGLE DRIVE
// ══════════════════════════════════════════════════
function getDriveRedirectUri() {
  // Must exactly match an Authorized redirect URI in Google Cloud Console
  return window.location.origin + window.location.pathname;
}

function updateDriveUI() {
  const dot = document.getElementById('driveDot');
  const lbl = document.getElementById('driveLabel');
  const btn = document.getElementById('driveConnBtn');
  if (state.driveConnected) {
    dot.classList.add('connected');
    lbl.textContent = 'Google Drive: Connected';
    btn.textContent = 'Manage';
  } else {
    dot.classList.remove('connected');
    lbl.textContent = 'Google Drive: Not Connected';
    btn.textContent = 'Connect';
  }
}

function updateAdminDriveStatus() {
  const status = document.getElementById('adminDriveStatus');
  const idInput = document.getElementById('driveClientId');
  const uriBox = document.getElementById('driveRedirectUri');
  const connectBtn = document.getElementById('driveConnectBtn');
  const disconnectBtn = document.getElementById('driveDisconnectBtn');
  if (idInput && state.driveClientId) idInput.value = state.driveClientId;
  if (uriBox) uriBox.textContent = getDriveRedirectUri();
  if (status) {
    status.innerHTML = state.driveConnected
      ? '✅ <span style="color:var(--green)">Connected</span> — reports will auto-backup to BCPS Field Logs folder.'
      : '⚠️ Not connected — reports will not be backed up automatically.';
  }
  if (connectBtn) connectBtn.style.display = state.driveConnected ? 'none' : '';
  if (disconnectBtn) disconnectBtn.style.display = state.driveConnected ? '' : 'none';
}

function openDriveModal() { document.getElementById('driveModal').classList.add('open'); }

function saveDriveClientId() {
  const v = document.getElementById('driveClientId').value.trim();
  if (!v) return alert('Enter a Google OAuth Client ID first.');
  state.driveClientId = v;
  saveState();
  updateAdminDriveStatus();
  alert('Client ID saved.\n\nIMPORTANT: Add this exact URL as an Authorized redirect URI in Google Cloud Console → your OAuth Client:\n\n' + getDriveRedirectUri());
}

function connectDrive() {
  if (!state.driveClientId) {
    alert('Save your Google OAuth Client ID in Admin → Google Drive Backup first.');
    return;
  }
  const redirect = encodeURIComponent(getDriveRedirectUri());
  const scope = encodeURIComponent('https://www.googleapis.com/auth/drive.file');
  const url =
    'https://accounts.google.com/o/oauth2/v2/auth' +
    '?client_id=' + encodeURIComponent(state.driveClientId) +
    '&redirect_uri=' + redirect +
    '&response_type=token' +
    '&scope=' + scope +
    '&include_granted_scopes=true' +
    '&prompt=consent';
  closeModal('driveModal');
  window.location.href = url;
}

function disconnectDrive() {
  if (!confirm('Disconnect Google Drive?')) return;
  state.driveConnected = false;
  state.driveToken = '';
  state.driveTokenExp = 0;
  state.driveRootFolderId = '';
  saveState();
  updateDriveUI();
  updateAdminDriveStatus();
}

function checkDriveCallback() {
  if (!window.location.hash) return;
  const params = new URLSearchParams(window.location.hash.slice(1));
  const token = params.get('access_token');
  if (!token) return;
  const expiresIn = parseInt(params.get('expires_in') || '3600', 10);
  state.driveToken = token;
  state.driveTokenExp = Date.now() + (expiresIn - 60) * 1000;
  state.driveConnected = true;
  saveState();
  history.replaceState(null, '', window.location.pathname + window.location.search);
  updateDriveUI();
  alert('✅ Google Drive connected! Reports will now auto-backup.');
}

async function ensureDriveFolder(name, parentId) {
  const escaped = name.replace(/'/g, "\\'");
  let q = "name='" + escaped + "' and mimeType='application/vnd.google-apps.folder' and trashed=false";
  if (parentId) q += " and '" + parentId + "' in parents";
  const queryUrl = 'https://www.googleapis.com/drive/v3/files?q=' + encodeURIComponent(q) + '&fields=files(id,name)&spaces=drive';
  const qr = await fetch(queryUrl, { headers: { Authorization: 'Bearer ' + state.driveToken } });
  if (!qr.ok) throw new Error('Drive query failed: ' + qr.status);
  const qj = await qr.json();
  if (qj.files && qj.files.length) return qj.files[0].id;
  const body = { name, mimeType: 'application/vnd.google-apps.folder' };
  if (parentId) body.parents = [parentId];
  const cr = await fetch('https://www.googleapis.com/drive/v3/files?fields=id', {
    method: 'POST',
    headers: { Authorization: 'Bearer ' + state.driveToken, 'Content-Type': 'application/json' },
    body: JSON.stringify(body)
  });
  if (!cr.ok) throw new Error('Drive folder create failed: ' + cr.status);
  const cj = await cr.json();
  return cj.id;
}

async function backupToDrive(reportData, jobName) {
  if (!state.driveConnected || !state.driveToken) return;
  if (state.driveTokenExp && Date.now() > state.driveTokenExp) {
    state.driveConnected = false;
    saveState();
    updateDriveUI();
    updateAdminDriveStatus();
    console.warn('Drive token expired; reconnect required.');
    return;
  }
  try {
    const rootId = await ensureDriveFolder('BCPS Field Logs', null);
    state.driveRootFolderId = rootId;
    saveState();
    const safeJob = (jobName || 'Unsorted').replace(/[\\/:*?"<>|]/g, '_');
    const jobFolderId = await ensureDriveFolder(safeJob, rootId);
    const date = new Date().toISOString().slice(0, 10);
    const filename = date + '_' + reportData.type + '.json';
    const boundary = '-------bcps' + Math.random().toString(36).slice(2);
    const metadata = { name: filename, parents: [jobFolderId] };
    const body =
      '--' + boundary + '\r\n' +
      'Content-Type: application/json; charset=UTF-8\r\n\r\n' +
      JSON.stringify(metadata) + '\r\n' +
      '--' + boundary + '\r\n' +
      'Content-Type: application/json\r\n\r\n' +
      JSON.stringify(reportData, null, 2) + '\r\n' +
      '--' + boundary + '--';
    const up = await fetch('https://www.googleapis.com/upload/drive/v3/files?uploadType=multipart&fields=id', {
      method: 'POST',
      headers: {
        Authorization: 'Bearer ' + state.driveToken,
        'Content-Type': 'multipart/related; boundary=' + boundary
      },
      body
    });
    if (up.status === 401) {
      state.driveConnected = false;
      saveState();
      updateDriveUI();
      updateAdminDriveStatus();
      throw new Error('Drive auth expired (401)');
    }
    if (!up.ok) throw new Error('Drive upload failed: ' + up.status);
  } catch (e) {
    console.warn('Drive backup error:', e);
  }
}

// ══════════════════════════════════════════════════
//  SUBMIT
// ══════════════════════════════════════════════════
function submitDaily() {
  const job = document.getElementById('d_job');
  if (!job.value) { alert('Please select an Active Job.'); return; }
  const jobName = job.options[job.selectedIndex].text;
  const report = { type:'daily', job:jobName, date:document.getElementById('d_date').value, submitted:new Date().toISOString() };
  backupToDrive(report, jobName);
  showConfirm('✅ Daily Report Submitted', `Daily log for "${jobName}" recorded successfully.${state.driveConnected ? '\n\nBacking up to Google Drive…' : '\n\nConnect Google Drive to auto-backup reports.'}`);
}

function submitPunch() {
  const job = document.getElementById('p_job');
  if (!job.value) { alert('Please select a Job.'); return; }
  if (sigEmpty('sigS')) { alert('Superintendent signature required.'); return; }
  if (sigEmpty('sigP')) { alert('Project Manager signature required.'); return; }
  const jobName = job.options[job.selectedIndex].text;
  const done = document.querySelectorAll('.pi-chk:checked').length;
  const all = document.querySelectorAll('.pi-chk').length;
  const report = { type:'punch', job:jobName, date:document.getElementById('p_date').value, submitted:new Date().toISOString() };
  backupToDrive(report, jobName);
  showConfirm('✅ Punch List Signed', `Punch list for "${jobName}" signed by both parties.\n${done} of ${all} items complete.${state.driveConnected ? '\n\nBacking up to Google Drive…' : ''}`);
}

function showConfirm(title, msg) {
  document.getElementById('cm_title').textContent = title;
  document.getElementById('cm_msg').textContent = msg;
  document.getElementById('confirmModal').classList.add('open');
}

