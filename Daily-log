}

// ══════════════════════════════════════════════════
//  JOB DROPDOWNS
// ══════════════════════════════════════════════════
function refreshJobDropdowns() {
  const active = state.jobs.filter(j => j.status === 'active');

  ['d_job','p_job','t_newJob','t_jobFilter'].forEach(id => {
    const sel = document.getElementById(id);
    if (!sel) return;
    const isFilter = id === 't_jobFilter';
    const prev = sel.value;
    sel.innerHTML = isFilter
      ? '<option value="all">— All Jobs —</option>'
      : '<option value="">— Select Job —</option>';
    active.forEach(j => {
      const o = document.createElement('option');
      o.value = j.id; o.textContent = j.name + (j.num ? ' ('+j.num+')' : '');
      sel.appendChild(o);
    });
    if (prev) sel.value = prev;
  });

  onJobChange();
}

function onJobChange() {
  const jobId = document.getElementById('d_job').value;
  const job = state.jobs.find(j => j.id === jobId);
  // rebuild billing code dropdowns in manpower table
  document.querySelectorAll('.bc-sel').forEach(sel => {
    const prev = sel.value;
    sel.innerHTML = '<option value="">— Tag —</option>';
    if (job) {
      job.codes.forEach(c => {
        const o = document.createElement('option');
        o.value = c; o.textContent = c; sel.appendChild(o);
      });
    }
    sel.value = prev;
  });
}

// ══════════════════════════════════════════════════
//  MANPOWER
// ══════════════════════════════════════════════════
